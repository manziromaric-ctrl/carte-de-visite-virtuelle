rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profils de carte de visite numérique Kongo Digital Wave
    // Lecture publique en direct pour tous les visiteurs du monde
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Analytics et interactions en temps réel pour mesurer les utilisateurs et pays
    match /card_interactions/{interactionId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    match /analytics_summary/{summaryId} {
      allow read, write: if true;
    }

    // Document de test pour validation de connexion
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
