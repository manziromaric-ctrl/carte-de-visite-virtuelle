rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profils de carte de visite numérique Kongo Digital Wave
    // Lecture publique en direct pour tous les visiteurs du monde
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Document de test pour validation de connexion
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
