{
  "entities": {
    "BusinessCardProfile": {
      "title": "BusinessCardProfile",
      "description": "Profil de carte de visite numérique synchronisé en direct et accessible en temps réel par tous les visiteurs.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "tagline": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "emblemUrl": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "googleMapsShareUrl": { "type": "string" },
        "services": { "type": "array" },
        "skills": { "type": "array" },
        "location": { "type": "object" },
        "showcaseVideos": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "title", "company", "phone", "email"]
    },
    "CardInteraction": {
      "title": "CardInteraction",
      "description": "Événement d'interaction en temps réel sur la carte de visite (vue, appel, whatsapp, vcard, partage, vidéo, etc.) avec géolocalisation de l'utilisateur.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "actionType": { "type": "string" },
        "actionLabel": { "type": "string" },
        "timestamp": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "flagEmoji": { "type": "string" },
        "city": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "referrer": { "type": "string" },
        "targetUrl": { "type": "string" }
      },
      "required": ["actionType", "timestamp"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": "BusinessCardProfile",
      "description": "Profil de la carte de visite numérique Kongo Digital Wave."
    },
    "/card_interactions/{interactionId}": {
      "schema": "CardInteraction",
      "description": "Flux en temps réel des interactions des utilisateurs avec pays et horodatage."
    },
    "/analytics_summary/{summaryId}": {
      "schema": "CardInteraction",
      "description": "Agrégats et métriques globales des interactions et visiteurs."
    }
  }
}
